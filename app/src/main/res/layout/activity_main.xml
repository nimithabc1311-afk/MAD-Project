<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#F4F7FC">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CampusLost"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#2457C5"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Smart Campus Lost &amp; Found"
        android:textSize="21sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lost something on campus? Found something belonging to someone else? CampusLost helps students report, search and recover their belongings easily."
        android:textSize="16sp"
        android:textColor="#666666"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:layout_marginBottom="35dp"/>

    <Button
        android:id="@+id/btnGetStarted"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Get Started"
        android:textSize="17sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2457C5"/>

</LinearLayout>
