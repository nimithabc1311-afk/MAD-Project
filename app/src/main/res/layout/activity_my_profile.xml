<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Profile"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2457C5"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full Name"
            android:textStyle="bold"
            android:textColor="#222222"/>

        <EditText
            android:id="@+id/etStudentName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter your full name"
            android:inputType="textPersonName"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USN / Student ID"
            android:textStyle="bold"
            android:textColor="#222222"/>

        <EditText
            android:id="@+id/etStudentUsn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter USN (e.g. 1MS21CS001)"
            android:inputType="textCapCharacters"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Email"
            android:textStyle="bold"
            android:textColor="#222222"/>

        <EditText
            android:id="@+id/etStudentEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="student@campus.edu"
            android:inputType="textEmailAddress"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Save Profile"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2457C5"/>

    </LinearLayout>

</ScrollView>
